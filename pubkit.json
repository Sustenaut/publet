      "ci / passed",
      "release / release",
      "integrations / scan"
    ],
    "release_app": 5529889
  },
  "security": {
    "sonar": {
      "args": "-Dsonar.coverage.exclusions=tests/**"
    }
  },
  "nightly": {
    "pins": {
      "crates": [
        "pubunit"
      ]
    }
  },
