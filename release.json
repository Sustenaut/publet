{
  "corpus": "corpus",
  "key": "pub:sha2-256:uuhj3tzrkc22p6vqspawqyva7zuwe5ns475xipjcyvfaw3hn3caa",
  "packages": [
    {
      "name": "publet-cli",
      "package": "pkg.publet-cli",
      "tag": "PKG-PUBCLI-10-2026",
      "manifest": {
        "kind": "cargo-workspace",
        "path": "Cargo.toml"
      },
      "code": [
        "crates/",
        "bin/",
        "porcelain/",
        "Cargo.toml",
        "Cargo.lock"
      ],
      "command": {
        "name": "pub",
        "check": "pub --version"
      },
      "install": "cargo install --locked --git https://github.com/schryer/publet --tag {tag} publet-cli"
    },
    {
      "name": "publet-core",
      "package": "pkg.publet-core",
      "tag": "PKG-PUBCOR-10-2026",
      "manifest": {
        "kind": "cargo-package",
        "path": "crates/publet-core/Cargo.toml"
      },
      "code": [
        "crates/publet-core/"
      ],
      "semver-checks": true
    },
    {
      "name": "publet-algorithms",
      "package": "pkg.publet-algorithms",
      "tag": "PKG-PUBALG-10-2026",
      "manifest": {
        "kind": "cargo-package",
        "path": "crates/publet-algorithms/Cargo.toml"
      },
      "code": [
        "crates/publet-algorithms/"
      ],
      "semver-checks": true
    }
  ],
  "security": {
    "checks": [
      {
        "name": "advisories, licences, bans and sources",
        "run": "cargo deny --locked check --hide-inclusion-graph",
        "version": "cargo deny --version"
      },
      {
        "name": "supply-chain audits",
        "run": "cargo vet --locked",
        "version": "cargo vet --version"
      },
      {
        "name": "supply-chain reports current",
        "run": ".venv/bin/pubkit supply-chain --check publet-core publet-algorithms",
        "version": ".venv/bin/pubkit --version"
      },
      {
        "name": "quality audit current",
        "run": ".venv/bin/pubkit audit --check",
        "version": ".venv/bin/pubkit --version"
      }
    ],
    "facts": [
      {
        "name": "RustSec advisory database revision",
        "run": "git -C \"$(ls -d ~/.cargo/advisory-dbs/advisory-db-*/ | head -1)\" log -1 --format='%H (%cs)'"
      },
      {
        "name": "audits imported from",
        "run": "grep -o '^\\[imports\\.[a-z-]*' supply-chain/config.toml | cut -d. -f2 | paste -sd, - | sed 's/,/, /g'"
      }
    ]
  }
}
